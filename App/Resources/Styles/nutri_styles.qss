
/* ==========================================
   NUTRIJOE - CARTOON BLACK & WHITE THEME
========================================== */


/* ==========================================
   ESTILOS GENERALES
========================================== */

QWidget {
    font-family: "Segoe UI";
    font-size: 14px;
    color: #111111;
}

QMainWindow {
    background-color: #f5f5f5;
}


/* ==========================================
   SIDEBAR
========================================== */

QWidget#Sidebar {
    background-color: #c7c7c7;
    min-width: 250px;
    max-width: 250px;

    border-right: 3px solid #111111;
}


/* ==========================================
   CABECERA SIDEBAR
========================================== */

QWidget#SidebarHeader {
    background-color: transparent;
}

QLabel#SidebarLogo {
    background-color: transparent;
    color: #111111;
    border: none;
    border-radius: 0px;
}

QLabel#SidebarBrand {
    color: #111111;
    font-size: 25px;
    font-weight: 900;
}

QLabel#SidebarSubtitle {
    color: #555555;
    font-size: 9px;
    font-weight: bold;
    letter-spacing: 2px;
}


/* ==========================================
   SEPARADOR
========================================== */

QFrame#SidebarSeparator {
    background-color: #111111;
    border: none;
    max-height: 2px;
}


/* ==========================================
   TÍTULOS DE SECCIÓN
========================================== */

QLabel#SidebarSectionTitle {
    color: #777777;
    font-size: 10px;
    font-weight: 900;

    padding: 8px 12px;
    letter-spacing: 2px;
}


/* ==========================================
   BOTONES SIDEBAR
========================================== */

QPushButton#SidebarButton {
    background-color: #949494;
    color: #111111;

    border: 2px solid transparent;
    border-radius: 10px;

    padding: 12px 14px;

    text-align: left;
    font-size: 14px;
    font-weight: bold;
}


/* ==========================================
   HOVER
========================================== */

QPushButton#SidebarButton:hover {
    background-color: #eeeeee;
    color: #000000;

    border: 2px solid #111111;
}


/* ==========================================
   BOTÓN SELECCIONADO
========================================== */

QPushButton#SidebarButton:checked {
    background-color: #111111;
    color: #ffffff;

    border: 2px solid #111111;
    border-radius: 10px;

    font-weight: 900;
}


/* ==========================================
   BOTÓN PRESIONADO
========================================== */

QPushButton#SidebarButton:pressed {
    background-color: #444444;
    color: #ffffff;
}


/* ==========================================
   SCROLLBARS (POR SI LAS NECESITAS)
========================================== */

QScrollBar:vertical {
    background: #ffffff;
    width: 8px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #111111;
    border-radius: 4px;
    min-height: 25px;
}

QScrollBar::handle:vertical:hover {
    background: #555555;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

#FlagButton {
    border: 2px solid transparent;
    border-radius: 6px;
    padding: 6px;
    background: transparent;
}

#FlagButton:hover {
    background: rgba(0, 0, 0, 0.05);
}

#FlagButton:checked {
    border: 2px solid #4CAF50;
}


/* ==========================================
   TÍTULOS DE PÁGINA
========================================== */

QLabel#PageTitle {
    font-size: 28px;
    font-weight: 900;
    color: #111111;
    padding: 4px 0px 12px 0px;
}


/* ==========================================
   BOTÓN PRINCIPAL (PÁGINAS)
========================================== */

QPushButton#PrimaryButton {
    background-color: #111111;
    color: #ffffff;
    border: 2px solid #111111;
    border-radius: 10px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#PrimaryButton:hover {
    background-color: #333333;
    border-color: #333333;
}

QPushButton#PrimaryButton:pressed {
    background-color: #555555;
    border-color: #555555;
}


/* ==========================================
   BUSCADOR DE ALIMENTOS
========================================== */

QLineEdit#SearchInput {
    background-color: #ffffff;
    border: 2px solid #111111;
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 14px;
    color: #111111;
}

QLineEdit#SearchInput:focus {
    border: 2px solid #444444;
    background-color: #ffffff;
}


/* ==========================================
   LISTA DE ALIMENTOS
========================================== */

QListWidget#FoodList {
    background-color: #ffffff;
    border: 2px solid #111111;
    border-radius: 12px;
    padding: 8px;
    font-size: 14px;
    outline: none;
}

QListWidget#FoodList::item {
    background-color: #f7f7f7;
    border: 1px solid #dcdcdc;
    border-radius: 8px;
    padding: 10px 12px;
    margin: 2px;
    color: #111111;
}

QListWidget#FoodList::item:hover {
    background-color: #eeeeee;
    border: 1px solid #111111;
}

QListWidget#FoodList::item:selected {
    background-color: #111111;
    color: #ffffff;
    border: 1px solid #111111;
}


/* ==========================================
   DIÁLOGO AÑADIR ALIMENTO
========================================== */

QDialog#AddFoodDialog {
    background-color: #f5f5f5;
}

QLabel#DialogTitle {
    font-size: 22px;
    font-weight: 900;
    color: #111111;
    padding-bottom: 4px;
}

QDialog#AddFoodDialog QLabel {
    font-size: 14px;
    font-weight: bold;
    color: #222222;
}

QDialog#AddFoodDialog QLineEdit,
QDialog#AddFoodDialog QDoubleSpinBox {
    background-color: #ffffff;
    border: 2px solid #111111;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 14px;
    color: #111111;
    selection-background-color: #111111;
    selection-color: #ffffff;
}

QDialog#AddFoodDialog QLineEdit:focus,
QDialog#AddFoodDialog QDoubleSpinBox:focus {
    border: 2px solid #444444;
    background-color: #ffffff;
}

QDialog#AddFoodDialog QDoubleSpinBox::up-button,
QDialog#AddFoodDialog QDoubleSpinBox::down-button {
    background-color: #f0f0f0;
    border-left: 1px solid #cccccc;
    width: 18px;
}

QDialog#AddFoodDialog QDoubleSpinBox::up-button:hover,
QDialog#AddFoodDialog QDoubleSpinBox::down-button:hover {
    background-color: #e0e0e0;
}

QDialog#AddFoodDialog QDialogButtonBox {
    padding-top: 6px;
}

QPushButton#PrimaryDialogButton {
    background-color: #111111;
    color: #ffffff;
    border: 2px solid #111111;
    border-radius: 8px;
    padding: 8px 18px;
    min-width: 100px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#PrimaryDialogButton:hover {
    background-color: #333333;
    border-color: #333333;
}

QPushButton#PrimaryDialogButton:pressed {
    background-color: #555555;
    border-color: #555555;
}

QPushButton#PrimaryDialogButton:disabled {
    background-color: #bdbdbd;
    color: #f0f0f0;
    border: 2px solid #bdbdbd;
}

QPushButton#SecondaryDialogButton {
    background-color: #ffffff;
    color: #111111;
    border: 2px solid #111111;
    border-radius: 8px;
    padding: 8px 18px;
    min-width: 100px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#SecondaryDialogButton:hover {
    background-color: #eeeeee;
}

QPushButton#SecondaryDialogButton:pressed {
    background-color: #dddddd;
}

