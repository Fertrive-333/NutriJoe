
/* ==========================================
   NUTRIJOE - MAIN STYLESHEET
========================================== */


/* ==========================================
   ESTILOS GENERALES
========================================== */

QWidget {
    font-family: "Segoe UI";
    font-size: 14px;
    color: #263445;
}

QMainWindow {
    background-color: #f5f7fa;
}


/* ==========================================
   SIDEBAR
========================================== */

QWidget#Sidebar {
    background-color: #17212b;
    min-width: 250px;
    max-width: 250px;
}


/* ==========================================
   CABECERA SIDEBAR
========================================== */

QWidget#SidebarHeader {
    background-color: transparent;
}

QLabel#SidebarLogo {
    background-color: #36b37e;
    color: white;
    border-radius: 12px;
    font-size: 24px;
    font-weight: bold;
}

QLabel#SidebarBrand {
    color: #ffffff;
    font-size: 24px;
    font-weight: bold;
}

QLabel#SidebarSubtitle {
    color: #8493a3;
    font-size: 9px;
    font-weight: bold;
    letter-spacing: 2px;
}


/* ==========================================
   SEPARADOR
========================================== */

QFrame#SidebarSeparator {
    background-color: #2b3947;
    border: none;
    max-height: 1px;
}


/* ==========================================
   TÍTULOS DE SECCIÓN
========================================== */

QLabel#SidebarSectionTitle {
    color: #718096;
    font-size: 10px;
    font-weight: bold;
    padding: 8px 12px;
    letter-spacing: 1px;
}


/* ==========================================
   BOTONES SIDEBAR
========================================== */

QPushButton#SidebarButton {
    background-color: transparent;
    color: #aebbc9;

    border: none;
    border-radius: 8px;

    padding: 13px 14px;

    text-align: left;
    font-size: 14px;
    font-weight: 500;
}


/* EFECTO HOVER */

QPushButton#SidebarButton:hover {
    background-color: #263541;
    color: #ffffff;
}


/* BOTÓN SELECCIONADO */

QPushButton#SidebarButton:checked {
    background-color: #263f3b;
    color: #48d597;

    border-left: 3px solid #36b37e;

    font-weight: bold;
}


/* BOTÓN PRESIONADO */

QPushButton#SidebarButton:pressed {
    background-color: #304b45;
}
