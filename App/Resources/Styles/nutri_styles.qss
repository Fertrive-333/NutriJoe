
/* ==========================================
   NUTRIJOE - CARTOON BLACK & WHITE THEME
========================================== */


/* ==========================================
   ESTILOS GENERALES
========================================== */

QWidget {
    font-family: "Segoe UI";
    font-size: 14px;
    color: #111111;
}

QMainWindow {
    background-color: #f5f5f5;
}


/* ==========================================
   SIDEBAR
========================================== */

QWidget#Sidebar {
    background-color: #ffffff;
    min-width: 250px;
    max-width: 250px;

    border-right: 3px solid #111111;
}


/* ==========================================
   CABECERA SIDEBAR
========================================== */

QWidget#SidebarHeader {
    background-color: transparent;
}

QLabel#SidebarLogo {
    background-color: transparent;
    color: #111111;
    border: none;
    border-radius: 0px;
}

QLabel#SidebarBrand {
    color: #111111;
    font-size: 25px;
    font-weight: 900;
}

QLabel#SidebarSubtitle {
    color: #555555;
    font-size: 9px;
    font-weight: bold;
    letter-spacing: 2px;
}


/* ==========================================
   SEPARADOR
========================================== */

QFrame#SidebarSeparator {
    background-color: #111111;
    border: none;
    max-height: 2px;
}


/* ==========================================
   TÍTULOS DE SECCIÓN
========================================== */

QLabel#SidebarSectionTitle {
    color: #777777;
    font-size: 10px;
    font-weight: 900;

    padding: 8px 12px;
    letter-spacing: 2px;
}


/* ==========================================
   BOTONES SIDEBAR
========================================== */

QPushButton#SidebarButton {
    background-color: #ffffff;
    color: #111111;

    border: 2px solid transparent;
    border-radius: 10px;

    padding: 12px 14px;

    text-align: left;
    font-size: 14px;
    font-weight: bold;
}


/* ==========================================
   HOVER
========================================== */

QPushButton#SidebarButton:hover {
    background-color: #eeeeee;
    color: #000000;

    border: 2px solid #111111;
}


/* ==========================================
   BOTÓN SELECCIONADO
========================================== */

QPushButton#SidebarButton:checked {
    background-color: #111111;
    color: #ffffff;

    border: 2px solid #111111;
    border-radius: 10px;

    font-weight: 900;
}


/* ==========================================
   BOTÓN PRESIONADO
========================================== */

QPushButton#SidebarButton:pressed {
    background-color: #444444;
    color: #ffffff;
}


/* ==========================================
   SCROLLBARS (POR SI LAS NECESITAS)
========================================== */

QScrollBar:vertical {
    background: #ffffff;
    width: 8px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #111111;
    border-radius: 4px;
    min-height: 25px;
}

QScrollBar::handle:vertical:hover {
    background: #555555;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}
